PROJECT_NAME="FORSEE Nexus API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DATABASE_URL="sqlite:///./forsee_nexus.db"
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
HOST="127.0.0.1"
PORT=8000

# Database Connection Pooling (PostgreSQL production tuning)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
